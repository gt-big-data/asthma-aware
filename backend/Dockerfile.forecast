FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY requirements/ /srv/requirements/
RUN pip install --no-cache-dir -r requirements/nasa-job.txt
COPY --chown=10001:10001 ingestion /srv/ingestion
COPY --chown=10001:10001 forecast_pipeline /srv/forecast_pipeline
COPY --chown=10001:10001 forecast_job/__init__.py forecast_job/storage.py /srv/forecast_job/
COPY --chown=10001:10001 scripts/__init__.py scripts/publish_nasa_forecast.py scripts/publish_processed_forecast.py /srv/scripts/
USER 10001:10001
ENTRYPOINT ["python", "-m", "scripts.publish_nasa_forecast"]
CMD ["--output-dir", "/tmp/nasa", "--hours", "48", "--bbox", "33.45,34.05,-84.80,-83.95", "--deadline", "240"]
