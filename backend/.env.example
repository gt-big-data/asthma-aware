# Copy to backend/.env; never commit real credentials.
# /dashboard uses fixtures; /health is an independent liveness check.
# Explicit local opt-in. Keep false for a deployed environment.
DASHBOARD_DEMO_ENABLED=false
# V1 uses verified user JWTs and never uses the demo identity.
# Configure ES256 or RS256 signing keys in the Supabase project.
SUPABASE_URL=
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Live NASA forecasts: disabled | file | database. Acquisition is manual only.
LIVE_FORECAST_STORE=disabled
LIVE_FORECAST_PATH=data/live-forecast.json
# Restricted forecast-writer login, only used by the manual publisher.
# Requires sslmode=require (or verify-ca / verify-full). Never expose to Expo.
FORECAST_PUBLISH_DATABASE_URL=

# Supabase Postgres + PostGIS. Leave blank until a database is configured.
# Use a migration-capable connection for Alembic; validate runtime pooling separately.
# Example: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=
# Separate migration-capable connection; never mount this in the API container.
MIGRATION_DATABASE_URL=
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=280
DEFAULT_REGION=atlanta

# Optional collectors; not used during API startup.
AIRNOW_API_KEY=
EE_PROJECT_ID=
CENSUS_API_KEY=

# Integration tests create/drop tables: use a separate disposable database.
TEST_DATABASE_URL=
TEST_DATABASE_ALLOW_RESET=false

# New cloud/backend entrypoint: uvicorn app.cloud:app
# Historical app.main prototype settings above are not deployment configuration.
CLOUD_PROJECT=
FORECAST_RAW_BUCKET=
FORECAST_PROCESSED_BUCKET=
FORECAST_DELIVERY_BUCKET=
# Optional local actual-object catalog directory (no generated data).
FORECAST_CATALOG_DIRECTORY=
FORECAST_DELIVERY_BASE_URL=
FORECAST_CDN_KEY_NAME=
# Existing 128-bit base64url signing secret; never put real values in this file.
FORECAST_CDN_SIGNING_KEY=
TASKS_ENABLED=false
TASKS_LOCATION=us-east1
TASKS_QUEUE=
TASKS_SERVICE_ACCOUNT_EMAIL=
PERSONALIZATION_WORKER_URL=
WORKER_AUDIENCE=
WORKER_SERVICE_ACCOUNT_EMAIL=
WORKER_DATABASE_URL=
PLACES_ENABLED=false
PLACES_API_KEY=
PLACES_REQUESTS_PER_MINUTE=5
