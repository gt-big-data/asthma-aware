# Copy to backend/.env and fill in. .env is gitignored -- never commit it.
# See backend/db/README.md for where these values come from.

# ---------------------------------------------------------------------------
# Database (required for anything that touches Postgres)
# ---------------------------------------------------------------------------
# Shared Postgres + PostGIS. Ask the team for the connection string rather
# than creating your own project -- the point is that everyone reads and
# writes the same data.
#
# Supabase: Project Settings -> Database -> Connection string -> URI.
#   Use the SESSION pooler (port 5432), not the transaction pooler (6543):
#   alembic and the collectors need features the latter does not support.
# Neon: copy the connection string from the project dashboard.
#
# postgres://, postgresql:// and postgresql+psycopg:// are all accepted.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# ---------------------------------------------------------------------------
# Satellite ingestion (ingestion.satellite.collector)
# ---------------------------------------------------------------------------
# Google Cloud project registered for Earth Engine. Run `earthengine
# authenticate` once on this machine first.
EE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Socioeconomic ingestion (ingestion.socioeconomic.collector)
# ---------------------------------------------------------------------------
# REQUIRED. The Census API rejects unauthenticated requests for a query
# this large -- it answers 302 to /missing_key.html rather than an error
# status, so without a key the collector fails and /map/socioeconomic
# serves the sample-data fallback instead of real numbers.
# Free, instant: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Log every SQL statement. Useful when debugging a slow upsert.
SQL_ECHO=false

# Recycle pooled connections below the provider's idle timeout. Hosted
# Postgres drops idle connections, and ingestion jobs sit idle while
# waiting on an upstream API.
DB_POOL_RECYCLE=280
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Default region slug for CLIs that take an optional --region.
DEFAULT_REGION=atlanta

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
# Only set this to run tests/test_db_integration.py. Point it at a
# THROWAWAY database -- the fixtures create and drop the entire schema.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/asthma_test
