# Copy to backend/.env; never commit real credentials.
# /dashboard uses fixtures; /health is an independent liveness check.
# Explicit local opt-in. Keep false for a deployed environment.
DASHBOARD_DEMO_ENABLED=false
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Supabase Postgres + PostGIS. Leave blank until a database is configured.
# Use a migration-capable connection for Alembic; validate runtime pooling separately.
# Example: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=280
DEFAULT_REGION=atlanta

# Optional collectors; not used during API startup.
AIRNOW_API_KEY=
EE_PROJECT_ID=
CENSUS_API_KEY=

# Integration tests create/drop tables: use a separate disposable database.
TEST_DATABASE_URL=
TEST_DATABASE_ALLOW_RESET=false
