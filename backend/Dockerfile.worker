FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY requirements/ /srv/requirements/
RUN pip install --no-cache-dir -r requirements/cloud-backend.txt
COPY --chown=10001:10001 app/__init__.py app/worker.py /srv/app/
COPY --chown=10001:10001 db /srv/db
COPY --chown=10001:10001 forecast_pipeline /srv/forecast_pipeline
COPY --chown=10001:10001 forecast_job/__init__.py forecast_job/storage.py /srv/forecast_job/
USER 10001:10001
CMD ["sh", "-c", "exec uvicorn app.worker:app --host 0.0.0.0 --port ${PORT:-8080}"]
